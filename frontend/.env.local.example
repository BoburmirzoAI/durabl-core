# =============================================================================
# Durabl frontend — muhit o'zgaruvchilari NAMUNASI
#
# Foydalanish:
#   cp .env.local.example .env.local   &&   npm run dev
#
# !!! DIQQAT !!!
# `NEXT_PUBLIC_` prefiksli qiymatlar BRAUZERGA uzatiladi va JS bundle ichiga
# joylanadi — ularda SIR (parol, token, kalit) SAQLASH QAT'IYAN TAQIQLANADI.
# =============================================================================

# -----------------------------------------------------------------------------
# Mock rejim (HOZIRGI HOLAT)
# -----------------------------------------------------------------------------
# Butun ilova `src/lib/mock/` dagi deterministik ma'lumot bilan ishlaydi.
# Backend ishlab turishi SHART EMAS — ilova mustaqil ishlaydi.

# Mock qatlamining sun'iy tarmoq kechikishi (ms) — real holatni taqlid qiladi.
# `src/lib/api/client.ts` o'qiydi. 0 qilsangiz hamma narsa darhol yuklanadi.
NEXT_PUBLIC_MOCK_LATENCY_MS=200

# -----------------------------------------------------------------------------
# Backend ulanishi (HOZIR ISHLATILMAYDI — keyingi qadam uchun tayyor)
# -----------------------------------------------------------------------------
# Backend manzili. Brauzer shu manzilga so'rov yuboradi, shuning uchun
# docker-compose servis nomi (`api`) emas, host manzili yoziladi.
#   lokal:      http://localhost:8000
#   production: https://api.durabl.dev
NEXT_PUBLIC_API_URL=http://localhost:8000

# Dev rejimida CORS'dan qutulish uchun Next proxy'si.
# `true` bo'lsa `/api/v1/*` so'rovlari Next server orqali backend'ga uzatiladi.
# Mock rejimda ma'nosi yo'q — backend ulangach yoqiladi.
# NEXT_PUBLIC_API_PROXY=false

# WebSocket manzili (real-time job holati). Hali hech kim o'qimaydi.
#   lokal:      ws://localhost:8000
#   production: wss://api.durabl.dev
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# -----------------------------------------------------------------------------
# Next.js xatti-harakati
# -----------------------------------------------------------------------------
# Next.js telemetriyasini o'chirish (tashqi so'rov yuborilmaydi)
NEXT_TELEMETRY_DISABLED=1

# Docker ichida fayl o'zgarishini kuzatish (hot reload ishlamasa `true` qiling).
# `docker-compose.yml` buni allaqachon `true` qilib beradi.
# WATCHPACK_POLLING=true
