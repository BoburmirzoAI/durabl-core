# =============================================================================
# Durabl — git kuzatmaydigan fayllar
# =============================================================================

# -----------------------------------------------------------------------------
# Muhit o'zgaruvchilari (SIRLAR — hech qachon commit qilinmaydi)
# `*.example` fayllar esa kuzatiladi (namuna sifatida)
# -----------------------------------------------------------------------------
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!*.env.example
!.env.local.example

