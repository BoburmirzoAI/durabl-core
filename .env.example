# =============================================================================
# Durabl — muhit o'zgaruvchilari NAMUNASI (docker-compose uchun)
#
# Foydalanish:
#   cp .env.example .env     &&     docker compose up -d
#
# Bu fayl `docker compose` tomonidan o'qiladi (barcha servislarga `env_file`
# orqali uzatiladi) va `app/config.py` dagi `Settings` maydonlariga mos keladi.
#
# !!! XAVFSIZLIK !!!
#   * `.env` fayli git'ga TUSHMAYDI (.gitignore'da) — faqat shu namuna kuzatiladi.
#   * Production'da ALBATTA almashtiring: SECRET_KEY, POSTGRES_PASSWORD,
#     GRAFANA_ADMIN_PASSWORD, BOOTSTRAP_ADMIN_PASSWORD.
# =============================================================================


# =============================================================================
# DOCKER COMPOSE (faqat compose uchun — `Settings` bunga tegmaydi)
# =============================================================================
# Postgres konteynerining boshlang'ich foydalanuvchisi/parol/bazasi.
# DATABASE_URL bilan MOS bo'lishi shart.
POSTGRES_USER=durabl
POSTGRES_PASSWORD=durabl
POSTGRES_DB=durabl
# Host'da ochiladigan portlar (band bo'lsa o'zgartiring)
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=3000

# pgAdmin — baza UI. Faqat `make up-tools` bilan ko'tariladi.
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@durabl.dev
PGADMIN_PASSWORD=durabl

# Grafana admin paroli (`make up-monitoring`)
GRAFANA_PASSWORD=durabl
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
# Grafana admin hisobi (`--profile monitoring` bilan ishga tushadi)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Host'dagi `docker` guruhining GID'i — worker sandbox yaratishi uchun.
# Linux'da aniqlash: getent group docker | cut -d: -f3
# macOS (Docker Desktop) uchun o'zgartirish shart emas.
DOCKER_GID=999
# Production (docker-compose.prod.yml) uchun qo'shimcha:
#   API_WORKERS=4                 # uvicorn protsesslari soni
#   WORKER_REPLICAS=3             # worker konteynerlari soni
#   WEBHOOK_SENDER_REPLICAS=2
#   HTTP_PORT=80
#   HTTPS_PORT=443
#   REDIS_MAXMEMORY=1gb
#   PROMETHEUS_RETENTION=30d
#   GRAFANA_ROOT_URL=https://grafana.durabl.dev


# =============================================================================
# APP — ilova
# =============================================================================
# Ilova nomi (OpenAPI hujjatida ko'rinadi)
APP_NAME=Durabl
# Versiya (OpenAPI va `/health` javobida)
APP_VERSION=1.0.0
# Muhit: development | test | staging | production
ENV=development
# Batafsil xato chiqishi. Production'da ALBATTA false.
DEBUG=true
# API yo'l prefiksi (barcha v1 endpointlar shu ostida)
API_V1_PREFIX=/api/v1
# /docs, /redoc, /openapi.json yoqilganmi (production'da false qilish tavsiya etiladi)
ENABLE_DOCS=true


# =============================================================================
# DATABASE — PostgreSQL (async SQLAlchemy)
# =============================================================================
# Ulanish manzili. Docker ichida xost nomi — `postgres` (servis nomi).
# Lokal (venv) ishlatganda: postgresql+asyncpg://durabl:durabl@localhost:5432/durabl
DATABASE_URL=postgresql+asyncpg://durabl:durabl@postgres:5432/durabl
# Har bir SQL so'rovni logga chiqarish (faqat debug uchun — juda shovqinli)
DB_ECHO=false
# Ulanish hovuzi hajmi (bir vaqtda ochiq ulanishlar)
DB_POOL_SIZE=10
# Hovuz to'lганda qo'shimcha ochiladigan ulanishlar soni
DB_MAX_OVERFLOW=20
# Hovuzdan ulanish kutish vaqti (soniya)
DB_POOL_TIMEOUT=30
# Ulanishni qancha vaqtdan keyin yangilash (soniya) — uzilgan ulanishlarga qarshi
DB_POOL_RECYCLE=1800
# Bitta SQL so'rov uchun maksimal vaqt (millisekund) — osilib qolishga qarshi
DB_STATEMENT_TIMEOUT_MS=30000


# =============================================================================
# REDIS — navbat, lease, idempotency, rate limit, pub/sub
# =============================================================================
# Docker ichida xost nomi — `redis`. Lokalda: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
# Ulanish hovuzining maksimal hajmi
REDIS_MAX_CONNECTIONS=50
# So'rov javobini kutish vaqti (soniya)
REDIS_SOCKET_TIMEOUT=5.0
# Ulanish o'rnatish vaqti (soniya)
REDIS_SOCKET_CONNECT_TIMEOUT=5.0
# `fakeredis` ishlatish — FAQAT testlar uchun (haqiqiy Redis kerak emas)
REDIS_FAKE=false


# =============================================================================
# SECURITY — JWT, API kalitlar, parol
# =============================================================================
# !!! PRODUCTION'DA ALBATTA ALMASHTIRING (kamida 32 belgi) !!!
# Yangi kalit yasash: openssl rand -hex 32
SECRET_KEY=CHANGE-ME-insecure-development-secret-key-min-32-chars
# JWT imzo algoritmi
JWT_ALGORITHM=HS256
# Access token amal qilish muddati (daqiqa)
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh token amal qilish muddati (kun)
REFRESH_TOKEN_EXPIRE_DAYS=30
# Mijoz ko'radigan API kalit prefiksi (`durabl_xxx`)
API_KEY_PREFIX=durabl_
# API kalitdagi tasodifiy baytlar soni (entropiya)
API_KEY_RANDOM_BYTES=32
# bcrypt murakkabligi. 12 — production, 4 — testlar (tezlik uchun)
BCRYPT_ROUNDS=12
# Parolning minimal uzunligi
PASSWORD_MIN_LENGTH=8


# =============================================================================
# CORS — brauzerdan kelgan so'rovlar
# =============================================================================
# Ruxsat etilgan manbalar — JSON ro'yxat ko'rinishida yoziladi
# (pydantic-settings `.env` faylidagi ro'yxatni JSON sifatida o'qiydi)
# Ikki shakl ham ishlaydi: `a,b` yoki `["a","b"]`
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Cookie/Authorization header'ini uzatishga ruxsat
CORS_ALLOW_CREDENTIALS=true


# =============================================================================
# RELIABILITY — lease, heartbeat, retry, idempotency (Durabl yadrosi)
# =============================================================================
# Worker job'ni olganda beriladigan lease muddati (soniya).
# Worker qulasa, shu muddatdan keyin job boshqa worker'ga o'tadi.
LEASE_TTL_SECONDS=15
# Worker har necha soniyada lease'ni yangilaydi.
# LEASE_TTL_SECONDS'dan KICHIK bo'lishi SHART (taxminan 1/3).
HEARTBEAT_INTERVAL_SECONDS=5
# Muddati o'tgan lease'larni tekshirish davri (reaper)
LEASE_REAPER_INTERVAL_SECONDS=5
# Standart qayta urinishlar soni (mijoz o'zgartirishi mumkin)
DEFAULT_MAX_RETRIES=3
# Mijoz so'rashi mumkin bo'lgan maksimal qayta urinish
MAX_ALLOWED_RETRIES=10
# Eksponensial backoff: birinchi kutish (soniya)
RETRY_BASE_DELAY_SECONDS=1.0
# Har urinishda kutish necha barobar oshadi
RETRY_MULTIPLIER=2.0
# Kutishning yuqori chegarasi (soniya)
RETRY_MAX_DELAY_SECONDS=300.0
# Jitter — ko'p job bir vaqtda qayta urinmasligi uchun tasodifiy qo'shimcha
RETRY_JITTER=true
# Jitter ulushi (0.25 = +/-25%)
RETRY_JITTER_RATIO=0.25
# Idempotency kaliti qancha saqlanadi (soniya; 86400 = 24 soat)
IDEMPOTENCY_TTL_SECONDS=86400


# =============================================================================
# EXECUTION — kod bajarish cheklovlari
# =============================================================================
# Job uchun standart vaqt chegarasi (soniya)
DEFAULT_TIMEOUT_SECONDS=30
# Maksimal ruxsat etilgan vaqt chegarasi (soniya; 900 = 15 daqiqa)
MAX_TIMEOUT_SECONDS=900
# Minimal vaqt chegarasi (soniya)
MIN_TIMEOUT_SECONDS=1
# Mijoz yuborishi mumkin bo'lgan kod hajmi (bayt; 262144 = 256 KB)
MAX_CODE_SIZE_BYTES=262144
# Payload (argumentlar) hajmi (bayt; 1048576 = 1 MB)
MAX_PAYLOAD_SIZE_BYTES=1048576
# Yig'iladigan stdout/stderr hajmi (bayt) — oshsa kesiladi (`truncated=true`)
MAX_OUTPUT_BYTES=1048576
# Bitta log yozuvining maksimal hajmi (bayt)
MAX_LOG_CHUNK_BYTES=16384
# Kod statik tahlili yoqilganmi (xavfli importlarni bloklash)
CODE_VALIDATION_ENABLED=true
# Qat'iy rejim — shubhali kod ham rad etiladi
CODE_VALIDATION_STRICT=false


# =============================================================================
# SANDBOX — gVisor izolyatsiyasi
# =============================================================================
# false — kod lokal subprocess'da bajariladi (FAQAT development/test!)
# true  — har bir job alohida konteynerda (production uchun majburiy)
# DIQQAT: Docker steki (`make up`) uchun bu `true` bo'lishi KERAK — worker'da
# Docker socket mount qilingan va runner image'lari qurilgan. `false` qilsangiz
# kod izolyatsiyasiz subprocess sifatida bajariladi va konteyner ichida
# `sandbox/runners/` yo'q bo'lgani uchun job DLQ'ga tushadi.
# Faqat LOKAL ishlashda (`make api-local`, `make worker`) `false` qiling.
SANDBOX_ENABLED=true
# Docker runtime: production'da `runsc` (gVisor), lokalda `runc`
SANDBOX_RUNTIME=runc
# Tarmoq rejimi: `none` — kod internetga chiqa olmaydi
SANDBOX_NETWORK_MODE=none
# Sandbox uchun xotira chegarasi (MB)
SANDBOX_MEMORY_MB=256
# Sandbox uchun CPU ulushi (0.5 = yarim yadro)
SANDBOX_CPUS=0.5
# Protsesslar soni chegarasi (fork bomba'ga qarshi)
SANDBOX_PIDS_LIMIT=50
# Vaqtinchalik disk hajmi (MB)
SANDBOX_DISK_MB=64
# Fayl tizimi faqat o'qish uchun (kod serverga yoza olmaydi)
SANDBOX_READ_ONLY_ROOTFS=true
# Python runner image nomi (`make sandbox-build` yasaydi)
SANDBOX_IMAGE_PYTHON=durabl/runner-python:latest
# Node runner image nomi
SANDBOX_IMAGE_NODE=durabl/runner-node:latest
# Docker demon manzili. Bo'sh — standart `/var/run/docker.sock`
SANDBOX_DOCKER_HOST=
# Konteynerni o'ldirgandan keyin kutish (soniya)
SANDBOX_KILL_GRACE_SECONDS=2.0
# Sandbox ishga tushishini kutish (soniya)
SANDBOX_STARTUP_TIMEOUT_SECONDS=30.0
# Seccomp profil fayli yo'li (bo'sh — Docker standarti).
# Konteyner ichidagi yo'l: /etc/durabl/seccomp-profile.json
SANDBOX_SECCOMP_PROFILE=
# tmpfs hajmi (MB) — /tmp uchun
SANDBOX_TMPFS_SIZE_MB=32
# Sandbox ichidagi foydalanuvchi (uid:gid) — root emas
SANDBOX_USER=10001:10001


# =============================================================================
# WORKER — fon ishchilari
# =============================================================================
# Bitta worker protsessida parallel bajariladigan job soni
WORKER_CONCURRENCY=4
# Navbatdan olishda kutish vaqti (soniya, BLMOVE timeout)
WORKER_POLL_TIMEOUT_SECONDS=5
# Worker identifikatori. Bo'sh bo'lsa `hostname-pid` dan yasaladi.
WORKER_ID=
# To'xtatishda joriy job'larni tugatishni kutish (soniya)
WORKER_SHUTDOWN_GRACE_SECONDS=30.0
# Worker heartbeat'i Redis'da qancha yashaydi (soniya)
WORKER_REGISTRY_TTL_SECONDS=30


# =============================================================================
# SCHEDULER — kechiktirilgan va cron job'lar
# =============================================================================
# Scheduler yoqilganmi
SCHEDULER_ENABLED=true
# Tekshirish davri (soniya)
SCHEDULER_INTERVAL_SECONDS=1.0
# Bir siklda navbatga qo'yiladigan job soni
SCHEDULER_BATCH_SIZE=100


# =============================================================================
# DLQ — o'lik xatlar navbati
# =============================================================================
# DLQ processor yoqilganmi
DLQ_PROCESSOR_ENABLED=true
# Tekshirish davri (soniya)
DLQ_PROCESSOR_INTERVAL_SECONDS=30.0
# DLQ'dagi job'larni avtomatik qayta urinish (ehtiyot bo'ling!)
DLQ_AUTO_RETRY_ENABLED=false
# Avtomatik qayta urinishlar soni
DLQ_AUTO_RETRY_MAX_ATTEMPTS=1
# DLQ chuqurligi shu qiymatdan oshsa alert yuboriladi
DLQ_ALERT_THRESHOLD=100


# =============================================================================
# WEBHOOK — natijani mijozga yuborish
# =============================================================================
# Webhook yuborish yoqilganmi
WEBHOOK_ENABLED=true
# HTTP so'rov vaqti chegarasi (soniya)
WEBHOOK_TIMEOUT_SECONDS=10.0
# Muvaffaqiyatsiz yuborishni qayta urinish soni
WEBHOOK_MAX_RETRIES=5
# Birinchi qayta urinishdan oldin kutish (soniya)
WEBHOOK_BASE_DELAY_SECONDS=2.0
# Qayta urinish kutishining yuqori chegarasi (soniya; 3600 = 1 soat)
WEBHOOK_MAX_DELAY_SECONDS=3600.0
# Sender navbatni tekshirish davri (soniya)
WEBHOOK_SENDER_INTERVAL_SECONDS=1.0
# Bir siklda yuboriladigan delivery soni
WEBHOOK_SENDER_BATCH_SIZE=50
# Imzo eskirgan deb hisoblanadigan vaqt (soniya) — replay hujumiga qarshi
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
# SSRF himoyasi — ichki tarmoq manzillariga webhook yuborilmaydi
WEBHOOK_BLOCK_PRIVATE_IPS=true
# Ruxsat etilgan sxemalar — JSON ro'yxat (production'da faqat ["https"] qoldiring)
WEBHOOK_ALLOWED_SCHEMES=["https","http"]


# =============================================================================
# RATE LIMIT — so'rov chastotasi cheklovi
# =============================================================================
# Cheklov yoqilganmi (reja bo'yicha limitlar `constants.PLAN_LIMITS` da)
RATE_LIMIT_ENABLED=true
# Autentifikatsiyasiz so'rovlar uchun IP bo'yicha limit (daqiqada)
RATE_LIMIT_ANONYMOUS_PER_MINUTE=20


# =============================================================================
# ANALYTICS va CACHE
# =============================================================================
# Statistika javoblari qancha keshlanadi (soniya)
STATS_CACHE_TTL_SECONDS=30
# Analitika uchun so'rash mumkin bo'lgan maksimal davr (kun)
ANALYTICS_MAX_RANGE_DAYS=90


# =============================================================================
# WEBSOCKET — real-time job holati
# =============================================================================
# Ping yuborish davri (soniya) — uzilgan ulanishni aniqlash uchun
WS_HEARTBEAT_INTERVAL_SECONDS=30.0
# Bitta foydalanuvchi uchun maksimal ulanish soni
WS_MAX_CONNECTIONS_PER_USER=5
# Yuborish navbatining hajmi (sekin mijoz serverni bloklamasligi uchun)
WS_SEND_QUEUE_SIZE=256


# =============================================================================
# OBSERVABILITY — log, metrika, xato kuzatuvi
# =============================================================================
# Log darajasi: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Log formati: `console` — development (o'qishga qulay), `json` — production
LOG_FORMAT=console
# Prometheus metrikalari yoqilganmi
METRICS_ENABLED=true
# Metrikalar endpointi (nginx orqali tashqariga chiqarilmaydi)
METRICS_PATH=/metrics
# Sentry DSN (bo'sh — xato kuzatuvi o'chirilgan)
SENTRY_DSN=
# Sentry trace namuna olish ulushi (0.1 = 10%)
SENTRY_TRACES_SAMPLE_RATE=0.1


# =============================================================================
# NOTIFICATIONS — ogohlantirishlar (DLQ to'lishi, worker qulashi)
# =============================================================================
# Xabarnomalar yoqilganmi
NOTIFICATIONS_ENABLED=false
# SMTP server manzili (bo'sh — email yuborilmaydi)
SMTP_HOST=
# SMTP porti (587 — STARTTLS)
SMTP_PORT=587
# SMTP foydalanuvchisi
SMTP_USER=
# SMTP paroli (SIR — git'ga tushmasin!)
SMTP_PASSWORD=
# Jo'natuvchi manzil
SMTP_FROM=noreply@durabl.dev
# Alert yuboriladigan webhook (masalan Slack incoming webhook)
ALERT_WEBHOOK_URL=


# =============================================================================
# BOOTSTRAP — birinchi ishga tushirishda admin yaratish
# =============================================================================
# Bo'sh bo'lsa admin yaratilmaydi. Yaratilgandan keyin bu qiymatlarni o'chirish
# va parolni almashtirish tavsiya etiladi.
BOOTSTRAP_ADMIN_EMAIL=
# !!! Kuchli parol qo'ying (PASSWORD_MIN_LENGTH dan uzun) !!!
BOOTSTRAP_ADMIN_PASSWORD=


# =============================================================================
# FRONTEND (Next.js — brauzerga uzatiladi, SIR SAQLAMAYDI!)
# =============================================================================
# Brauzer ko'radigan API manzili (konteyner nomi emas!)
NEXT_PUBLIC_API_URL=http://localhost:8000
# WebSocket manzili
NEXT_PUBLIC_WS_URL=ws://localhost:8000
