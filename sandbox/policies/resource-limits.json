{
  "_izoh": [
    "Durabl — sandbox resurs limitlari.",
    "`plans` bo'limidagi qiymatlar app/constants.py dagi PLAN_LIMITS bilan",
    "AYNAN mos bo'lishi SHART (nomlar ham bir xil) — `resource_limiter.py`",
    "limitlarni reja bo'yicha hal qiladi, bu fayl esa sandbox qatlami uchun",
    "yagona hujjatlashtirilgan manba.",
    "`sandbox` bo'limidagi qo'shimcha qiymatlar (pids_limit, disk_mb, tmpfs)",
    "PLAN_LIMITS'da yo'q — ular faqat konteyner darajasida ma'noga ega."
  ],
  "version": 1,

  "defaults": {
    "_izoh": "app/config.py dagi SANDBOX_* standart qiymatlari bilan bir xil.",
    "memory_mb": 256,
    "cpus": 0.5,
    "pids_limit": 50,
    "disk_mb": 64,
    "tmpfs_size_mb": 32,
    "timeout_seconds": 30,
    "read_only_rootfs": true,
    "network_mode": "none",
    "user": "10001:10001",
    "max_output_bytes": 1048576,
    "kill_grace_seconds": 2.0,
    "startup_timeout_seconds": 30.0
  },

  "plans": {
    "free": {
      "plan": "free",
      "monthly_jobs": 1000,
      "requests_per_minute": 30,
      "max_concurrent_jobs": 2,
      "max_timeout_seconds": 30,
      "max_memory_mb": 256,
      "max_cpus": 0.5,
      "log_retention_days": 3,
      "allow_network": false,
      "price_usd_month": 0.0,
      "sandbox": {
        "pids_limit": 50,
        "disk_mb": 64,
        "tmpfs_size_mb": 32,
        "network_profile": "none",
        "rlimits": { "nofile": 256, "nproc": 64, "fsize_mb": 64 }
      }
    },
    "starter": {
      "plan": "starter",
      "monthly_jobs": 50000,
      "requests_per_minute": 120,
      "max_concurrent_jobs": 10,
      "max_timeout_seconds": 120,
      "max_memory_mb": 512,
      "max_cpus": 1.0,
      "log_retention_days": 14,
      "allow_network": true,
      "price_usd_month": 29.0,
      "sandbox": {
        "pids_limit": 100,
        "disk_mb": 128,
        "tmpfs_size_mb": 64,
        "network_profile": "restricted",
        "rlimits": { "nofile": 512, "nproc": 96, "fsize_mb": 128 }
      }
    },
    "pro": {
      "plan": "pro",
      "monthly_jobs": 500000,
      "requests_per_minute": 600,
      "max_concurrent_jobs": 50,
      "max_timeout_seconds": 300,
      "max_memory_mb": 1024,
      "max_cpus": 2.0,
      "log_retention_days": 30,
      "allow_network": true,
      "price_usd_month": 99.0,
      "sandbox": {
        "pids_limit": 200,
        "disk_mb": 256,
        "tmpfs_size_mb": 128,
        "network_profile": "restricted",
        "rlimits": { "nofile": 1024, "nproc": 192, "fsize_mb": 256 }
      }
    },
    "enterprise": {
      "plan": "enterprise",
      "monthly_jobs": 10000000,
      "requests_per_minute": 5000,
      "max_concurrent_jobs": 500,
      "max_timeout_seconds": 900,
      "max_memory_mb": 4096,
      "max_cpus": 4.0,
      "log_retention_days": 90,
      "allow_network": true,
      "price_usd_month": 499.0,
      "sandbox": {
        "pids_limit": 512,
        "disk_mb": 1024,
        "tmpfs_size_mb": 256,
        "network_profile": "full",
        "rlimits": { "nofile": 4096, "nproc": 512, "fsize_mb": 1024 }
      }
    }
  },

  "docker_flag_mapping": {
    "_izoh": "Limit -> `docker run` bayrog'i. `sandbox_manager.py` shu moslikni ishlatadi.",
    "max_memory_mb": "--memory=<N>m --memory-swap=<N>m",
    "max_cpus": "--cpus=<N>",
    "pids_limit": "--pids-limit=<N>",
    "disk_mb": "--storage-opt size=<N>m (faqat devicemapper/overlay2+xfs quota bilan)",
    "tmpfs_size_mb": "--tmpfs /tmp:rw,noexec,nosuid,size=<N>m",
    "read_only_rootfs": "--read-only",
    "user": "--user 10001:10001",
    "network_mode": "--network=<profil>",
    "max_timeout_seconds": "konteyner bayrog'i emas — `timeout_guard` + entrypoint SIGALRM"
  },

  "hard_caps": {
    "_izoh": [
      "Hech bir reja oshib keta olmaydigan mutlaq chegaralar.",
      "Mijoz so'rovi (`JobCreate.memory_mb`, `cpus`) ham, reja limiti ham",
      "shu qiymatlar bilan kesiladi — sozlama xatosi serverni yiqitmasligi uchun."
    ],
    "memory_mb": 8192,
    "cpus": 8.0,
    "pids_limit": 1024,
    "timeout_seconds": 900,
    "output_bytes": 10485760
  },

  "oom_behavior": {
    "_izoh": [
      "Konteyner xotira limitidan oshsa, kernel OOM killer protsessni o'ldiradi.",
      "Docker exit kodi 137 (128 + SIGKILL) bo'ladi va `State.OOMKilled=true`.",
      "`result_collector` buni `FailureReason.OOM` deb belgilaydi.",
      "`--memory-swap` xotira limitiga TENG qo'yiladi: aks holda konteyner",
      "swap hisobiga limitdan oshib ketadi va host sekinlashadi."
    ],
    "exit_code": 137,
    "failure_reason": "out_of_memory"
  },

  "enforcement_layers": {
    "_izoh": "Bir xil limit bir necha qatlamda takrorlanadi — bitta qatlam ishlamay qolsa boshqasi ushlaydi.",
    "layers": [
      "1. API validatsiyasi — JobCreate schema (timeout, memory, cpus reja limiti bilan solishtiriladi)",
      "2. Docker/cgroup — --memory, --cpus, --pids-limit, --tmpfs size",
      "3. gVisor — syscall qatlami, cgroup limitlarini hurmat qiladi (--ignore-cgroups=false)",
      "4. entrypoint rlimit — RLIMIT_NOFILE / RLIMIT_NPROC / RLIMIT_FSIZE",
      "5. timeout_guard — worker tomonidan konteynerni o'ldirish (SIGTERM -> SIGKILL)",
      "6. result_collector — chiqish hajmini 1 MB da kesish (truncated=true)"
    ]
  }
}
